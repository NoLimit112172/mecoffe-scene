    },
    {
      "function": "dining",
      "id": "dining-suffix",
      "pattern": "(?:食堂|餐厅|咖啡馆|咖啡厅|快餐店)(?:[A-Za-z0-9一二三四五六七八九十]+区)?$"
    },
    {
      "function": "retail",
      "id": "retail-suffix",
      "pattern": "(?:购物广场|商业广场|购物中心|商场|百货大楼|超市|便利店)$"
    },
    {
      "function": "life_service",
      "id": "life_service-suffix",
      "pattern": "(?:银行|邮局|邮政所|快递驿站|理发店|理发室|洗衣店|维修店)$"
    },
    {
      "function": "medical",
      "id": "medical-suffix",
      "pattern": "(?:医院|卫生院|诊所|药店|医务室|门诊楼|住院楼|急诊楼|医技楼|住院部|门诊部|病房楼)$"
    },
    {
      "function": "government",
      "id": "government-suffix",
      "pattern": "(?:人民政府|街道办事处|街道办|居委会|派出所|消防站)$"
    },
    {
      "function": "sports",
      "id": "sports-suffix",
      "pattern": "(?:体育馆|健身房|游泳馆)$"
    },
    {
      "function": "culture",
      "id": "culture-suffix",
      "pattern": "(?:博物馆|剧院|电影院|活动中心|KTV|ktv)$"
    },
    {
      "function": "religious",
      "id": "religious-suffix",
      "pattern": "(?:寺庙|寺|教堂|清真寺)$"
    },
    {
      "function": "transport",
      "id": "transport-suffix",
      "pattern": "(?:火车站|汽车站|客运站|地铁站|车站|停车楼)$"
    },
    {
      "function": "utility",
      "id": "utility-suffix",
      "pattern": "(?:配电房|配电室|锅炉房|泵房|门卫室?|垃圾站|公厕|厕所)$"
    },
    {
      "function": "construction",
      "id": "construction-suffix",
      "pattern": "(?:在建楼|施工楼|废弃楼|废弃建筑)$"
    }
  ],
