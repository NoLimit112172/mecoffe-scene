    },
    {
      "function": "office",
      "id": "office-suffix",
      "pattern": "(?:办公楼|行政楼|写字楼)$"
    },
    {
      "function": "library",
      "id": "library-suffix",
      "pattern": "图书馆$"
    },
    {
      "function": "industrial",
