{
  "ai_min_confidence_pct": 80,
  "exclusion_patterns": [
    "旧址|遗址|拆除|筹建|拟建|原址|^原",
    "道路|路口|公交站牌|公交站点|地铁出入口|(?:路|街|大道|大街|东门|西门|南门|北门|大门|停车场)$",
    "宠物医院$"
  ],
  "name_rules": [
    {
      "function": "dormitory",
      "id": "dormitory-suffix",
      "pattern": "(?:学生公寓|宿舍楼?)(?:[A-Za-z0-9一二三四五六七八九十]+(?:号楼|栋|区))?$"
    },
    {
      "function": "residential",
      "id": "residential-suffix",
      "pattern": "(?:住宅楼|居民楼|别墅)$"
    },
    {
