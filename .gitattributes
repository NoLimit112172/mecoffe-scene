# Limit explicit line-ending rules to scripts and provenance data.

# Windows PowerShell 5.1 keeps the script's UTF-8 BOM; use native line endings.
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Preserve the exact bytes used by provenance and runtime hash checks.
data/source/*.json -text diff
frontend/public/mecoffe/*.json -text diff
frontend/public/mecoffe/campuses/**/*.json -text diff
frontend/public/mecoffe/scenarios/**/*.json -text diff
frontend/public/mecoffe/scenarios/index.json -text diff

# M15 synthetic map manifests hash file bytes, including line endings.
frontend/tests/fixtures/scene-render/maps/**/*.json -text diff
frontend/tests/fixtures/scene-render/maps/**/*.geojson -text diff
adapter/scene_builder/resources/**/*.json -text diff
data/maps/**/*.json -text diff
data/maps/**/*.geojson -text diff

# Keep downloaded OSM bytes identical to the recorded SHA-256 on Windows.
frontend/public/mecoffe/scenarios/**/gis/*.geojson -text diff
data/osm/*.osm -text diff

# Keep the pinned model bundle byte-identical for offline integrity tests.
frontend/public/mecoffe/assets3d/rocketbox/*.md -text diff
frontend/public/mecoffe/assets3d/rocketbox/*.json -text diff
frontend/public/mecoffe/assets3d/rocketbox/**/*.fbx binary
frontend/public/mecoffe/assets3d/rocketbox/**/*.png binary
# Vendored upstream documentation intentionally keeps its original whitespace.
frontend/public/mecoffe/assets3d/rocketbox/UPSTREAM_README.md -whitespace
frontend/public/mecoffe/assets3d/rocketbox/derivatives/openomsi/*.md -text diff
frontend/public/mecoffe/assets3d/rocketbox/derivatives/openomsi/CREDITS.md -whitespace

# Frozen automatic-evidence rules and new v2 map fixtures use exact bytes.
adapter/scene_service/evidence_rules.json -text
frontend/tests/fixtures/scene-auto/** -text
# Generated runtime delivery keeps identical bytes on Windows and Linux.
packages/scene-service/** -text
